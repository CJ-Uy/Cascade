# ===========================
# Cascade - Environment Variables Template
# ===========================
# For local development: Copy to .env.local
# ===========================

# ===========================
# OPTIONAL: Support Configuration
# ===========================
# Google Form link for support tickets (if using)
NEXT_PUBLIC_GFORM_SUPPORT_TICKET_LINK=

# ===========================
# OPTIONAL: Node Configuration
# ===========================
# Node environment (development, production, test)
NODE_ENV=production

# Application port
PORT=3000

# Hostname to bind to
HOSTNAME=0.0.0.0

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# ===========================
# DEPLOYMENT NOTES
# ===========================
# Local Development:
#   - Copy this file to .env.local
#   - .env.local is gitignored
#
# Security:
#   - Never commit .env or .env.local to version control
#   - All NEXT_PUBLIC_* variables are exposed to the browser
